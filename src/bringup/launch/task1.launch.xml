<launch>
  <!-- TODO: verify the Jetson UART device and baud rate wired to the Orange Cube -->
  <arg name="fcu_url" default="serial:///dev/ttyTHS0:921600"/>

  <!-- "local": pole = [east, north] in meters from the takeoff point -->
  <!-- "gps":   pole = [latitude, longitude] in degrees -->
  <!-- Always write decimals, e.g. [0.0, 10.0], not [0, 10] -->
  <arg name="coord_frame" default="local"/>
  <arg name="pole1" default="[0.0, 10.0]"/>
  <arg name="pole2" default="[0.0, 20.0]"/>

  <include file="$(find-pkg-share mavros)/launch/node.launch">
    <arg name="fcu_url" value="$(var fcu_url)"/>
    <arg name="gcs_url" value=""/>
    <arg name="tgt_system" value="1"/>
    <arg name="tgt_component" value="1"/>
    <arg name="pluginlists_yaml" value="$(find-pkg-share bringup)/config/mavros_plugins.yaml"/>
    <arg name="config_yaml" value="$(find-pkg-share mavros)/launch/apm_config.yaml"/>
  </include>

  <node pkg="mission" exec="task1" output="screen">
    <param from="$(find-pkg-share bringup)/config/task1.yaml"/>
    <param name="coord_frame" value="$(var coord_frame)"/>
    <param name="pole1" value="$(var pole1)"/>
    <param name="pole2" value="$(var pole2)"/>
  </node>
</launch>
